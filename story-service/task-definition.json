{
    "family": "hisubtory-story-task",
    "executionRoleArn": "arn:aws:iam::180618475875:role/hisubtory-ecs-task-execution-role",
    "taskRoleArn": "arn:aws:iam::180618475875:role/hisubtory-ecs-task-role",
    "containerDefinitions": [
        {
            "name": "app",
            "image": "180618475875.dkr.ecr.ap-northeast-2.amazonaws.com/hisubtory-story:latest",
            "portMappings": [{ "containerPort": 80, "hostPort": 80, "protocol": "tcp" }],
            "essential": true,
            "environment": [
                { "name": "DB_HOST", "value": "hisubtory-db.cnwkq8oe8jr5.ap-northeast-2.rds.amazonaws.com" },
                { "name": "DB_NAME", "value": "hisubtory_db" },
                { "name": "DB_USER", "value": "admin" },
                { "name": "DB_PORT", "value": "3306" },
                { "name": "REDIS_HOST", "value": "hisubtory-redis.rkthpz.0001.apn2.cache.amazonaws.com" },
                { "name": "REDIS_PORT", "value": "6379" },
                { "name": "SB_DB_HOST", "value": "aws-1-ap-northeast-2.pooler.supabase.com" },
                { "name": "SB_DB_NAME", "value": "postgres" },
                { "name": "SB_DB_USER", "value": "postgres.jlvhwihvmivvihffhxse" },
                { "name": "SB_DB_PORT", "value": "5432" },
                { "name": "SUPABASE_URL", "value": "https://jlvhwihvmivvihffhxse.supabase.co" },
                { "name": "AWS_S3_REGION_NAME", "value": "ap-northeast-2" },
                { "name": "AWS_STORAGE_BUCKET_NAME", "value": "hisubtory-media-bucket" },
                { "name": "DEBUG", "value": "True" },
                { "name": "DB_PASSWORD", "value": "" },
                { "name": "SB_DB_PASSWORD", "value": "" },
                { "name": "SUPABASE_KEY", "value": "" },
                { "name": "SECRET_KEY", "value": "" },
                { "name": "AWS_ACCESS_KEY_ID", "value": "" },
                { "name": "AWS_SECRET_ACCESS_KEY", "value": "" }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/hisubtory-story",
                    "awslogs-region": "ap-northeast-2",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "requiresCompatibilities": ["FARGATE"],
    "networkMode": "awsvpc",
    "cpu": "256",
    "memory": "512"
}
