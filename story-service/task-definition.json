{
    "family": "hisubtory-story-task",
    "executionRoleArn": "arn:aws:iam::714454205561:role/hisubtory-ecs-task-execution-role",
    "taskRoleArn": "arn:aws:iam::714454205561:role/hisubtory-ecs-task-role",
    "containerDefinitions": [
        {
            "name": "app",
            "image": "714454205561.dkr.ecr.ap-northeast-2.amazonaws.com/hisubtory-story:latest",
            "portMappings": [{ "containerPort": 80, "hostPort": 80, "protocol": "tcp" }],
            "essential": true,
            "environment": [
                { "name": "DB_PASSWORD", "value": "" },
                { "name": "SB_DB_PASSWORD", "value": "" },
                { "name": "REDIS_HOST", "value": "" },
                { "name": "AWS_ACCESS_KEY_ID", "value": "" },
                { "name": "AWS_SECRET_ACCESS_KEY", "value": "" },
                { "name": "AWS_STORAGE_BUCKET_NAME", "value": "" },
                { "name": "SUPABASE_URL", "value": "" },
                { "name": "SUPABASE_KEY", "value": "" },
                { "name": "SECRET_KEY", "value": "" },
                { "name": "DEBUG", "value": "False" }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/hisubtory-story",
                    "awslogs-region": "ap-northeast-2",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "requiresCompatibilities": ["FARGATE"],
    "networkMode": "awsvpc",
    "cpu": "256",
    "memory": "512"
}
