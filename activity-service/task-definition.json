{
    "family": "hisubtory-activity-task",
    "executionRoleArn": "arn:aws:iam::714454205561:role/hisubtory-ecs-task-execution-role",
    "taskRoleArn": "arn:aws:iam::714454205561:role/hisubtory-ecs-task-role",
    "containerDefinitions": [
        {
            "name": "app",
            "image": "714454205561.dkr.ecr.ap-northeast-2.amazonaws.com/hisubtory-activity:latest",
            "portMappings": [{ "containerPort": 80, "hostPort": 80, "protocol": "tcp" }],
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/hisubtory-activity",
                    "awslogs-region": "ap-northeast-2",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "requiresCompatibilities": ["FARGATE"],
    "networkMode": "awsvpc",
    "cpu": "256",
    "memory": "512"
}
