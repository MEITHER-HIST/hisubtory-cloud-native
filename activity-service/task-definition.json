{
    "family": "hisubtory-activity-task",
    "containerDefinitions": [
        {
            "name": "app",
            "image": "714454205561.dkr.ecr.ap-northeast-2.amazonaws.com/hisubtory-activity:latest",
            "portMappings": [{ "containerPort": 80, "hostPort": 80, "protocol": "tcp" }],
