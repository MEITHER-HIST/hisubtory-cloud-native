{
  "containerDefinitions": [
    {
      "name": "app",
      "image": "180618475875.dkr.ecr.ap-northeast-2.amazonaws.com/hisubtory-web",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/hisubtory-web",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "systemControls": []
    }
  ],
  "family": "hisubtory-web-task",
  "taskRoleArn": "arn:aws:iam::180618475875:role/hisubtory-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::180618475875:role/hisubtory-ecs-task-execution-role",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
